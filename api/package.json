{
  "name": "api",
  "version": "1.0.0",
  "description": "The REST API for MediCitas",
  "repository": {
    "type": "git",
    "url": ".."
  },
  "license": "MIT",
  "author": "Erik, Johana, Neithan",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/clean-dist.mjs && npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
