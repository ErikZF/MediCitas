# REST Client local values (not service startup configuration).
# If requests/.env does not exist, copy this file from the repository root:
#   Copy-Item requests/.env.example requests/.env
# Replace every placeholder in the ignored local copy; never commit real tokens.

# Direct service origins, no trailing slash. .invalid URLs are safe placeholders.
DEMO_GATEWAY_URL=http://gateway.invalid
DEMO_CLINICS_URL=http://clinics.invalid
DEMO_USERS_URL=http://users.invalid
DEMO_APPOINTMENTS_URL=http://appointments.invalid
DEMO_AUDIT_URL=http://audit.invalid

# Fresh access tokens WITHOUT "Bearer "; obtain them from Keycloak using the seeded users:
#   platform.admin | admin.sj | reception.sj | dr.mora  (password = KEYCLOAK_TEST_PASSWORD)
DEMO_PLATFORM_ADMIN_TOKEN=
DEMO_CLINIC_ADMIN_TOKEN=
DEMO_RECEPTIONIST_TOKEN=
DEMO_PROFESSIONAL_TOKEN=

# Seeded Clinic 1 (clinic-sj-01) resource UUIDs from database/*/seed.sql; clinic-role tokens and resources must share this clinic.
# The professional token (dr.mora) must identify DEMO_PROFESSIONAL_ID.
DEMO_PROFESSIONAL_ID=019a0000-0000-7000-8000-000000000501
DEMO_PATIENT_ID=019a0000-0000-7000-8000-000000000601
DEMO_CONFLICT_PATIENT_ID=019a0000-0000-7000-8000-000000000602
DEMO_SERVICE_ID=019a0000-0000-7000-8000-000000000301
# Domain app_user_id (dr.mora) for audit filtering, not the Keycloak sub.
DEMO_AUDIT_USER_ID=019a0000-0000-7000-8000-000000000404

# Seeded Clinic 1 booked appointment that has already started (startsAt <= now), owned by dr.mora.
DEMO_STARTED_APPOINTMENT_ID=019a0000-0000-7000-8000-000000000804

# Clinic-local calendar dates, YYYY-MM-DD; RF8 includes both ends, at most 31 days.
DEMO_DAY_FROM=REPLACE_WITH_YYYY-MM-DD
DEMO_DAY_TO=REPLACE_WITH_YYYY-MM-DD

# Absolute instants with Z/offset, at most millisecond precision; FROM < TO.
# These filter appointment starts (counts) and event times (audit), not local days.
DEMO_RANGE_FROM=REPLACE_WITH_ISO_INSTANT
DEMO_RANGE_TO=REPLACE_WITH_LATER_ISO_INSTANT

# Future free slots from availability, within working hours and outside blocks.
DEMO_STARTS_A=REPLACE_WITH_FUTURE_ISO_INSTANT
DEMO_REPLACEMENT_STARTS_A=REPLACE_WITH_OTHER_FREE_FUTURE_ISO_INSTANT
