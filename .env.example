BASE_URI=http://localhost

# Express
API_PORT=3000
API_INTERNAL_PORT=3000

# Standard internal PostgreSQL port
POSTGRE_INTERNAL_PORT=5432

# 1. Database: Appointments
DB_APPOINTMENTS_HOST=db_appointments
DB_APPOINTMENTS_USER=your_user
DB_APPOINTMENTS_PASSWORD=your_secure_password
DB_APPOINTMENTS_NAME=appointments_db
DB_APPOINTMENTS_PORT=5433

# 2. Database: Users
DB_USERS_HOST=db_users
DB_USERS_USER=your_user
DB_USERS_PASSWORD=your_secure_password
DB_USERS_NAME=users_db
DB_USERS_PORT=5434

# 3. Database: Logs
DB_LOGS_HOST=db_logs
DB_LOGS_USER=your_user
DB_LOGS_PASSWORD=your_secure_password
DB_LOGS_NAME=logs_db
DB_LOGS_PORT=5435

# 4. Database: Clinics
DB_CLINICS_HOST=db_clinics
DB_CLINICS_USER=your_user
DB_CLINICS_PASSWORD=your_secure_password
DB_CLINICS_NAME=clinics_db
DB_CLINICS_PORT=5436

# Required by users-service (GET /specialties) and appointments-service (time zone and service catalog).
CLINICS_SERVICE_URL=
# Required by appointments-service (professionals and patients of the clinic).
USERS_SERVICE_URL=

# Keycloak credentials
KEYCLOAK_ADMIN_USERNAME=your_user
KEYCLOAK_ADMIN_PASSWORD=your_secure_password
KEYCLOAK_PORT=8080
KEYCLOAK_INTERNAL_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000

# Keycloak Config
REALM_NAME=Sistema_Clinico
CLIENT_ID=Medi_Citas

# Integration tests
KEYCLOAK_TEST_PASSWORD=your_test_password
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Required: set the exact issuer and API audience agreed with N3.
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_TEST_CLIENT_ID=integration-tests

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_password
# Availability cache in appointments-service (card E8). CACHE_ENABLED=false sends every read to PostgreSQL.
REDIS_URL=redis://:your_secure_password@localhost:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
