{
  "info": {
    "name": "MediCitas - Demo",
    "description": "Direct-service demo requests. Import the safe environment and follow postman/README.md (English) or README.es.md. Send one request at a time; stop on unexpected status or unresolved variables. Optional administration changes disposable data. Assertions describe expected results; this file is not evidence of a full-stack execution. No login endpoint or real secrets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health",
      "description": "Run first. Direct URLs need the local Compose port override.",
      "item": [
        {
          "name": "Gateway root",
          "request": {
            "method": "GET",
            "header": [],
