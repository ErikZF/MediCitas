            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{managedUsername}}\",\n  \"initialPassword\": \"{{initialPassword}}\",\n  \"role\": \"professional\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
