            "description": "Public. Expected 200 text Hello World!; no forwarding.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Public root\", () => pm.expect(pm.response.text()).to.eql(\"Hello World!\"));"
                ]
              }
            }
          ],
          "response": []
        },
