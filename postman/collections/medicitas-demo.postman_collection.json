    {
      "name": "01 - Clinic onboarding (optional)",
      "description": "Creates a separate clinic. Does not change Clinic 1 tokens or seeded variables. Use a unique identifier and username; initialPassword is local only.",
      "item": [
        {
          "name": "RF1 - Create clinic and first administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{clinicsUrl}}/clinics",
            "description": "Platform administrator only. Requires running users/Keycloak Admin API. Captures demoClinicId and bootstrapAdminId. 409 on duplicate active clinic; see contract for pending-bootstrap recovery.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{platformAdminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{clinicName}}\",\n  \"identifier\": \"{{clinicIdentifier}}\",\n  \"timeZone\": \"{{clinicTimeZone}}\",\n  \"administrator\": {\n    \"username\": \"{{bootstrapUsername}}\",\n    \"initialPassword\": \"{{initialPassword}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"clinicId is a UUID\", () => pm.expect(data.clinicId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  "  if (typeof data.clinicId === \"string\" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(data.clinicId)) pm.environment.set(\"demoClinicId\", data.clinicId);",
                  "  else pm.environment.unset(\"demoClinicId\");",
                  "  pm.test(\"appUserId is a UUID\", () => pm.expect(data.appUserId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  "  if (typeof data.appUserId === \"string\" && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(data.appUserId)) pm.environment.set(\"bootstrapAdminId\", data.appUserId);",
                  "  else pm.environment.unset(\"bootstrapAdminId\");",
                  "} else {",
                  "  pm.environment.unset(\"demoClinicId\");",
                  "  pm.environment.unset(\"bootstrapAdminId\");",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Read Clinic 1 time zone",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{clinicsUrl}}/clinic/time-zone",
            "description": "Uses the clinic in admin.sj token; not demoClinicId.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clinicAdminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
